generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
}

enum PlacementBranch {
  NTL
  XVNT
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  fullName     String?
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([username])
}

/// Lean placement list rows — no content blobs on this table.
model PlacementAttempt {
  id            String           @id @default(cuid())
  externalId    String           @unique
  studentName   String
  branch        PlacementBranch
  testLabel     String
  testSlug      String
  finishedAt    DateTime
  scoreCorrect  Int?
  scoreTotal    Int?
  scorePercent  Float?
  detailUrl     String           @default("")
  source        String           @default("admin")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([finishedAt])
  @@index([branch, finishedAt])
  @@index([source, finishedAt])
  @@index([studentName])
}

enum FastbotsChatStatus {
  OPEN
  CLOSED
  UNKNOWN
}

model FastbotsConversation {
  id               String             @id @default(cuid())
  externalId       String             @unique
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  channel          String?
  conversationType String?
  lastMessage      String?            @db.Text
  status           FastbotsChatStatus @default(UNKNOWN)
  startedAt        DateTime?
  closedAt         DateTime?
  tags             String[]           @default([])
  rawPayload       Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, startedAt])
  @@index([channel, startedAt])
  @@index([startedAt])
  @@index([updatedAt])
  @@index([contactEmail])
}

/// Latest Sale Pipeline snapshot pushed by Apps Script (NTL / XVNT).
model WeWinSaleSnapshot {
  branch  String   @id
  readAt  DateTime @map("read_at")
  payload Json

  @@map("wewin_sale_snapshot")
}
