# MUST match IELTS / sibling apps (≥16 chars) so wewin_session verifies everywhere.
SESSION_SECRET="change-me-to-a-long-random-string"

# Shared cookie Domain for SSO across *.wewin.edu.vn (production).
# SESSION_COOKIE_DOMAIN=".wewin.edu.vn"

# Public URL of this Admin Panel (used in return_to after IELTS login).
NEXT_PUBLIC_ADMIN_ORIGIN="https://admin.wewin.edu.vn"

# IELTS IdP login (temporary IdP). Unauthenticated admin pages redirect here.
IELTS_LOGIN_URL="https://ielts.wewin.edu.vn/login"

# Hub lean APIs — server BFF uses Bearer WEWIN_HUB_API_KEY (never expose to browser).
# Same key as wewin-ielts / Cambridge. Falls back to local PlacementAttempt when remote fails.
WEWIN_HUB_API_KEY="change-me-long-random-hub-key"
IELTS_HUB_URL="https://ielts.wewin.edu.vn/api/hub/placement-attempts"
# Browser origin for «Xem bài» result links (defaults to origin of IELTS_HUB_URL).
IELTS_PUBLIC_SITE_URL="https://ielts.wewin.edu.vn"
CAMBRIDGE_HUB_URL="https://cambridge-placement-test.vercel.app/api/hub/placement-attempts"
CAMBRIDGE_PUBLIC_SITE_URL="https://cambridge-placement-test.vercel.app"
# Exam practice hub (demo-luyen-thi / exam.wewin.edu.vn) — same WEWIN_HUB_API_KEY.
EXAM_HUB_URL="https://exam.wewin.edu.vn/api/hub/exam-attempts"
EXAM_PUBLIC_SITE_URL="https://exam.wewin.edu.vn"
# TOEIC hub (wewin-toeic / toeic.wewin.edu.vn) — same WEWIN_HUB_API_KEY.
TOEIC_HUB_URL="https://toeic.wewin.edu.vn/api/hub/toeic-attempts"
TOEIC_PUBLIC_SITE_URL="https://toeic.wewin.edu.vn"
# VSTEP hub (WeWIN-VSTEP / vstep.wewin.edu.vn) — same WEWIN_HUB_API_KEY.
VSTEP_HUB_URL="https://vstep.wewin.edu.vn/api/hub/vstep-attempts"
VSTEP_PUBLIC_SITE_URL="https://vstep.wewin.edu.vn"

# PostgreSQL (AdminPanel-owned database — not shared with IELTS).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wewin_admin?schema=public"

# Seed admin (used by `npm run db:seed`). Password ≥8 chars, letter + digit.
ADMIN_SEED_EMAIL="admin@wewin.local"
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="change-me-Admin123"

# Fastbots Chat History (optional until webhook/sync is wired)
# FASTBOTS_WEBHOOK_SECRET="change-me-fastbots-secret-16"
# FASTBOTS_DASHBOARD_URL="https://app.fastbots.ai/"
# FACEBOOK_PAGE_ID=""
# FACEBOOK_PAGE_ACCESS_TOKEN=""

